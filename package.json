{
  "name": "opencode-in-chrome",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "Session-owned Chrome tabs for OpenCode through an authenticated local MCP bridge.",
  "repository": {
    "type": "git",
    "url": "https://github.com/abenjaminov/opencode-in-chrome.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node bridge/setup.js",
    "install:opencode": "node scripts/install.js",
    "doctor": "node scripts/doctor.js",
    "pair": "node scripts/pair.js",
    "package": "node scripts/package.js",
    "start": "node bridge/main.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && node scripts/check-metadata.js && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10"
  }
}
